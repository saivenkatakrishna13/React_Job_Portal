PORT=4000
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
FRONTEND_URL=http://localhost:5173
MONGO_URI=
JWT_SECRET_KEY=
JWT_EXPIRE=7d
COOKIE_EXPIRE=7
NODE_ENV=development
# --- AI provider (Groq, OpenAI-compatible) ---
# Three keys, round-robin with automatic failover (report §9): a 429 cools
# only the offending key and immediately retries the SAME model on the next
# key; the model chain advances only when all 3 keys are cooling. Keep them
# as three distinct vars so one key can be rotated/revoked individually.
# Leave all three empty to run in mock mode: AI routes answer with
# canned-but-realistic JSON computed from the real inputs, no key needed.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Optional: overrides the built-in default model. NOTE: this Groq account's
# catalog does not serve the llama-3.3/llama-3.1/mixtral IDs (404/400 on
# 2026-10-26); the defaults below are models the account actually serves,
# each verified live with response_format=json_object.
GROQ_MODEL=openai/gpt-oss-120b
# Optional: comma-separated fallback models tried when the primary returns 404/410
# (strong primary → architecturally different mid-size → small/fast)
GROQ_MODEL_FALLBACKS=qwen/qwen3.8-27b,allam-2-7b
# Optional: true forces mock answers even with keys set; false forces live
# calls (at least one key then required). Unset = live when a key is set,
# mock otherwise.
# AI_MOCK_MODE=true
